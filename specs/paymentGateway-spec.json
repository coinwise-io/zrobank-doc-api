      "/v1/payments": {
        "get": {
          "description": "<b>Description</b>: Retrieve payments for the authenticated user with pagination and sorting options.",
          "operationId": "V1GetAllTransactionsRestController_execute_v1",
          "parameters": [
            {
              "name": "nonce",
              "in": "header",
              "description": "The nonce ID is a UUID (v4) used to uniquely identify the \n        request. All requests must have an identifier.\n      ",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "x-lang",
              "in": "header",
              "description": "Indicates the preferred language. Defaults to Brazilian \n        Portuguese if unspecified.\n      ",
              "required": false,
              "schema": {
                "type": "string",
                "enum": [
                  "pt-BR",
                  "en-US"
                ]
              }
            },
            {
              "name": "x-product-uuid",
              "in": "header",
              "description": "The product ID is a UUID (v4) used to identify the Z.ro \n        product configuration.\n      ",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "x-product-target-user-uuid",
              "in": "header",
              "description": "The product target user ID is a UUID (v4) used to identify \n        what user account this request must be executed.\n        Require: x-product-uuid. \n      ",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "page",
              "required": false,
              "in": "query",
              "description": "Page number.",
              "schema": {
                "default": 1,
                "type": "number"
              }
            },
            {
              "name": "size",
              "required": false,
              "in": "query",
              "description": "Page size. Max size is 100.",
              "schema": {
                "maximum": 100,
                "default": 20,
                "type": "number"
              }
            },
            {
              "name": "sort",
              "required": false,
              "in": "query",
              "description": "Page sort attribute.",
              "schema": {
                "example": "created_at",
                "enum": [
                  "created_at"
                ],
                "type": "string"
              }
            },
            {
              "name": "order",
              "required": false,
              "in": "query",
              "description": "Page order.",
              "schema": {
                "default": "asc",
                "enum": [
                  "asc",
                  "desc"
                ],
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Payments retrieved successfully.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GetAllPaymentRestResponse"
                  }
                }
              }
            },
            "400": {
              "description": "If any required params are missing or has invalid format or type."
            },
            "401": {
              "description": "User authentication failed."
            },
            "422": {
              "description": "If any required params are missing or has invalid format or type."
            }
          },
          "security": [
            {
              "bearer": []
            }
          ],
          "summary": "Get all payments",
          "tags": [
            "Payments"
          ]
        },
        "post": {
          "description": "<b>Description</b>: Endpoint that processes a payment.",
          "operationId": "V1CreateAcquirerTransactionRestController_execute_v1",
          "parameters": [
            {
              "name": "x-transaction-uuid",
              "in": "header",
              "description": "The transaction ID is a UUID (v4) used to uniquely identify the object that will be created. All objects must have an identifier.",
              "required": true,
              "schema": {
