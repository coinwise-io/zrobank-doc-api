            "401": {
              "description": "User authentication failed."
            },
            "422": {
              "description": "If any required params are missing or has invalid format or type."
            }
          },
          "security": [
            {
              "bearer": []
            }
          ],
          "summary": "Create Payment",
          "tags": [
