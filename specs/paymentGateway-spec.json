    "info": {
      "title": "Z.ro Bank Payments Gateway API",
      "description": "Z.ro Bank Payments Gateway API",
      "version": "1.53.0",
      "contact": {
        "name": "Z.ro Bank",
        "url": "https://www.zrobank.com.br",
        "email": "tecnologia@zrobank.com.br"
      },
      "license": {
        "name": "All rights reserved",
        "url": "https://www.zrobank.com.br"
      }
    },
    "tags": [],
    "servers": [],
    "components": {
      "securitySchemes": {
        "bearer": {
          "scheme": "bearer",
          "bearerFormat": "JWT",
          "type": "http"
        }
      },
      "schemas": {
        "V1AuthenticateRestRequest": {
          "type": "object",
          "properties": {
            "api_id": {
              "type": "string",
              "description": "User defined apiId.",
              "example": "2af31bf2-e676-4e81-8dde-dfd671124f00"
            },
            "api_key": {
              "type": "string",
              "description": "User defined apiKey.",
              "example": "superpassword"
            }
          },
          "required": [
            "api_id",
            "api_key"
          ]
        },
        "AuthenticateRestResponse": {
          "type": "object",
          "properties": {
            "access_token": {
              "type": "string",
              "description": "JWT access token. Token used to access all protected endpoints."
            }
          },
          "required": [
            "access_token"
          ]
        },
        "RefreshTokenRestResponse": {
          "type": "object",
          "properties": {
            "access_token": {
              "type": "string",
              "description": "JWT access token. Token used to access all protected endpoints."
            }
          },
          "required": [
            "access_token"
          ]
        },
        "GetPaymentByIdRestResponse": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Payment ID",
              "example": "b28163ec-3d28-4786-a154-7a28ab3600a6"
            },
            "sales_channel": {
              "type": "string",
              "description": "Sales channel used for the Payment",
              "enum": [
                "POS",
                "PDV",
                "MPOS",
                "PAYLINK",
                "INTEGRATION",
                "TAP_ON_PHONE",
                "VIRTUAL_TERMINAL"
              ],
              "example": "INTEGRATION"
            },
            "transaction_method": {
              "type": "string",
              "description": "Payment method (Card Present or Card Not Present)",
              "enum": [
                "CNP",
                "CP"
              ],
              "example": "CP"
            },
            "payment_method": {
              "type": "string",
              "description": "Payment method used",
              "enum": [
                "DEBIT",
                "CREDIT"
              ],
              "example": "CREDIT"
            },
            "amount_local": {
              "type": "number",
              "description": "Payment value in local currency in cents",
              "example": 1000
            },
            "amount_original": {
              "type": "number",
              "description": "Payment value in original currency in cents",
              "example": 200
            },
            "amount_iof": {
              "type": "number",
              "description": "IOF (Tax on Financial Operations) amount",
              "example": 2
            },
            "currency_local": {
              "type": "string",
              "description": "Currency used for the payment in local market"
            },
            "currency_original": {
              "type": "string",
              "description": "Original currency of the payment"
            },
            "currency_rate": {
              "type": "number",
              "description": "Exchange rate applied to the payment",
              "example": 5
            },
            "status": {
              "type": "string",
              "description": "Current payment status",
              "enum": [
                "PENDING",
                "AUTHORIZED",
                "REVERTED",
                "CANCELLED",
                "SETTLED"
              ],
              "example": "AUTHORIZED"
            },
            "buyer_name": {
              "type": "string",
              "description": "Buyer full name",
              "example": "John Doe"
            },
            "buyer_email": {
              "type": "string",
              "description": "Buyer email address",
              "example": "john.doe@example.com"
            },
            "buyer_address": {
              "type": "object",
              "description": "Buyer address information",
              "example": {
                "street": "Main Street",
                "number": 123,
                "city": "São Paulo",
                "federativeUnit": "SP",
                "zipCode": "01234-567",
                "country": "Brazil",
                "neighborhood": "Downtown",
                "complement": "Apt 456"
              }
            },
            "buyer_phone_number": {
              "type": "string",
              "description": "Buyer phone number",
              "example": "+5511999998888"
            },
            "buyer_document_type": {
              "type": "string",
              "description": "Buyer document type",
              "enum": [
                "CPF",
                "CNPJ"
              ],
              "example": "CPF"
            },
            "buyer_document": {
              "type": "string",
              "description": "Buyer document number",
              "example": "12345678901"
            },
            "card_last_numbers": {
              "type": "string",
              "description": "Last four digits of the card used",
              "example": "1234"
            },
            "installments": {
              "type": "number",
              "description": "Number of installments for the payment",
              "example": 1
            },
            "refund_id": {
              "type": "string",
              "description": "Refund ID if payment was refunded",
              "example": "b321ef4f-eb5b-40a6-b862-dc47d6861ccc"
            },
            "chargeback_id": {
              "type": "string",
              "description": "Chargeback ID if payment was charged back",
              "example": "9c5ea602-e41a-452c-9698-ab05b761b189"
            },
            "creation_date": {
              "format": "date-time",
              "type": "string",
              "description": "Payment creation date",
              "example": "2023-01-01T10:00:00.000Z"
            },
            "last_update_date": {
              "format": "date-time",
              "type": "string",
              "description": "Payment last update date",
              "example": "2023-01-01T11:00:00.000Z"
            },
            "confirmation_date": {
              "format": "date-time",
              "type": "string",
              "description": "Payment confirmation date",
              "example": "2023-01-01T12:00:00.000Z"
            },
            "expected_settlement_date": {
              "format": "date-time",
              "type": "string",
              "description": "Expected settlement date",
              "example": "2023-01-02T12:00:00.000Z"
            }
          },
          "required": [
            "id",
            "sales_channel",
            "transaction_method",
            "payment_method",
            "amount_local",
            "amount_original",
            "amount_iof",
            "currency_local",
            "currency_original",
            "currency_rate",
            "status",
            "buyer_name",
            "buyer_email",
            "buyer_address",
            "buyer_phone_number",
            "buyer_document_type",
            "buyer_document",
            "card_last_numbers",
            "installments",
            "refund_id",
            "chargeback_id",
            "creation_date",
            "last_update_date",
            "confirmation_date",
            "expected_settlement_date"
          ]
        },
